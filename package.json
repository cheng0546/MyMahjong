{
    "name":  "my-mahjong",
    "version":  "1.0.0",
    "description":  "私人四川麻将血战到底(仅限好友联机)",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "deploy":  "npm run build && wrangler deploy --config dist/my_mahjong/wrangler.json",
                    "deploy:dry-run":  "npm run build && wrangler deploy --dry-run --config dist/my_mahjong/wrangler.json",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "cf-typegen":  "wrangler types"
                },
    "type":  "module",
    "dependencies":  {
                         "react":  "19.3.1",
                         "react-dom":  "19.3.1"
                     },
    "devDependencies":  {
                            "@cloudflare/vite-plugin":  "1.70.1",
                            "@cloudflare/vitest-plugin":  "1.9.2",
                            "@cloudflare/workers-types":  "5.20261124.1",
                            "@playwright/test":  "1.65.1",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "@vitejs/plugin-react":  "6.3.0",
                            "typescript":  "7.0.2",
                            "vite":  "8.3.8",
                            "vitest":  "5.1.1",
                            "wrangler":  "4.168.0"
                        },
    "allowScripts":  {
                         "esbuild@0.28.2":  true,
                         "workerd@1.20261117.1":  true,
                         "workerd@1.20261123.1":  true
                     },
    "private":  true,
    "engines":  {
                    "node":  ">=20.19.0"
                }
}
